# ------------------------------------------------------------------
#  Biznes Baza — backend muhit o'zgaruvchilari
#  Lokal uchun bu faylni `.env` qilib nusxalang va to'ldiring.
#  Railway'da o'zgaruvchilar Dashboard → Variables orqali kiritiladi.
# ------------------------------------------------------------------

# PostgreSQL ulanish manzili.
# Railway'da Postgres plaginini qo'shgach, app xizmatiga
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# ko'rinishida reference qo'shiladi.
DATABASE_URL="postgresql://user:password@localhost:5432/biznes"

# Server porti. Railway'da bu qiymat avtomatik beriladi — qoldirish mumkin.
PORT=4000

# CORS (ixtiyoriy). "*" — hamma domenlarga ruxsat.
# Frontend boshqa domenda hosted bo'lsa, shu yerga uning manzilini yozing.
CORS_ORIGIN=*

# Frontend API manzili (faqat frontend alohida hosted bo'lsa kerak).
# Server o'zi ham frontend'ni bersa, bu o'zgaruvchini qoldirmang.
# VITE_API_URL="https://your-app.up.railway.app/api"

# --- Admin login (vaqtinchalik autentifikatsiya) ---
# /api/auth/login shu qiymatlar bilan tekshiradi. Berilmasa:
# admin / admin123. Ishlab chiqarishda albatta o'zgartiring.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
